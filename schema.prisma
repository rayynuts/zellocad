generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions             Session[]
  notifications        Notification[]
  memberships          ServerMember[]
  ownedServers         Server[]                 @relation("ServerOwner")
  invitations          Invitation[]
  joinRequests         JoinRequest[]            @relation("JoinRequester")
  reviewedJoins        JoinRequest[]            @relation("JoinReviewer")
  departmentMembers    DepartmentMember[]
  applications         DepartmentApplication[]  @relation("Applicant")
  reviewedApplications DepartmentApplication[]  @relation("ApplicationReviewer")
  units                Unit[]
  callsCreated         Call[]                   @relation("CallCreator")
  reports              Report[]
  bolos                Bolo[]
  radioMessages        RadioMessage[]
  markers              MapMarker[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  serverId  String?
  type      String
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Server {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("")
  iconUrl     String?
  bannerUrl   String?
  discordUrl     String?
  applicationUrl String?
  visibility     String   @default("PRIVATE")
  joinMode    String   @default("APPROVAL")
  category    String   @default("Roleplay")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner         User            @relation("ServerOwner", fields: [ownerId], references: [id])
  members       ServerMember[]
  invitations   Invitation[]
  joinRequests  JoinRequest[]
  departments   Department[]
  calls         Call[]
  units         Unit[]
  reports       Report[]
  bolos         Bolo[]
  radioMessages RadioMessage[]
  markers       MapMarker[]
  resources     ResourceDoc[]
}

model ResourceDoc {
  id        String   @id @default(cuid())
  serverId  String
  title     String
  url       String
  createdAt DateTime @default(now())
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

model ServerMember {
  id            String    @id @default(cuid())
  serverId      String
  userId        String
  role          String    @default("MEMBER")
  favorite      Boolean   @default(false)
  lastVisitedAt DateTime?
  joinedAt      DateTime  @default(now())
  server        Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@index([userId])
}

model Invitation {
  id           String    @id @default(cuid())
  serverId     String
  code         String    @unique
  createdById  String
  expiresAt    DateTime?
  revokedAt    DateTime?
  useCount     Int       @default(0)
  maxUses      Int?
  createdAt    DateTime  @default(now())
  server       Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy    User      @relation(fields: [createdById], references: [id])
  joinRequests JoinRequest[]

  @@index([serverId])
}

model JoinRequest {
  id           String    @id @default(cuid())
  serverId     String
  userId       String
  invitationId String?
  status       String    @default("PENDING")
  message      String    @default("")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  server       Server     @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user         User       @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  invitation   Invitation? @relation(fields: [invitationId], references: [id])
  reviewedBy   User?      @relation("JoinReviewer", fields: [reviewedById], references: [id])

  @@index([serverId, status])
  @@index([userId])
}

model Department {
  id          String   @id @default(cuid())
  serverId    String
  name        String
  slug        String
  description String   @default("")
  color       String
  icon        String
  access      String   @default("APPLICATION")
  createdAt   DateTime @default(now())
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  members     DepartmentMember[]
  applications DepartmentApplication[]
  units       Unit[]
  radioMessages RadioMessage[]

  @@unique([serverId, slug])
}

model DepartmentMember {
  id           String     @id @default(cuid())
  departmentId String
  userId       String
  role         String     @default("MEMBER")
  joinedAt     DateTime   @default(now())
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
}

model DepartmentApplication {
  id              String    @id @default(cuid())
  departmentId    String
  userId          String
  status          String    @default("PENDING")
  message         String    @default("")
  decisionMessage String    @default("")
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  department      Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user            User       @relation("Applicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?      @relation("ApplicationReviewer", fields: [reviewedById], references: [id])

  @@index([departmentId, status])
  @@index([userId])
}

model Unit {
  id            String      @id @default(cuid())
  serverId      String
  userId        String
  departmentId  String?
  callsign      String
  displayName   String
  status        String      @default("AVAILABLE")
  posX          Float       @default(760)
  posY          Float       @default(320)
  currentCallId String?
  server        Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  currentCall   Call?       @relation("UnitCurrentCall", fields: [currentCallId], references: [id], onDelete: SetNull)
  assignments   CallAssignment[]

  @@unique([serverId, userId])
  @@unique([serverId, callsign])
}

model Call {
  id          String    @id @default(cuid())
  serverId    String
  title       String
  category    String
  priority    String    @default("MEDIUM")
  location    String
  posX        Float     @default(760)
  posY        Float     @default(320)
  description String    @default("")
  status      String    @default("PENDING")
  notes       String    @default("")
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  closedAt    DateTime?
  server      Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("CallCreator", fields: [createdById], references: [id])
  assignments CallAssignment[]
  unitsOnCall Unit[]    @relation("UnitCurrentCall")
  markers     MapMarker[]

  @@index([serverId, status])
}

model CallAssignment {
  id        String   @id @default(cuid())
  callId    String
  unitId    String
  createdAt DateTime @default(now())
  call      Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  unit      Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([callId, unitId])
}

model Report {
  id        String   @id @default(cuid())
  serverId  String
  title     String
  body      String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([serverId])
}

model Bolo {
  id          String   @id @default(cuid())
  serverId    String
  title       String
  description String
  status      String   @default("ACTIVE")
  createdById String
  createdAt   DateTime @default(now())
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([serverId, status])
}

model RadioMessage {
  id           String      @id @default(cuid())
  serverId     String
  userId       String
  departmentId String?
  message      String
  createdAt    DateTime    @default(now())
  server       Server      @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([serverId, createdAt])
}

model MapMarker {
  id          String   @id @default(cuid())
  serverId    String
  callId      String?
  label       String
  posX        Float
  posY        Float
  createdById String
  createdAt   DateTime @default(now())
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  call        Call?    @relation(fields: [callId], references: [id], onDelete: SetNull)
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@index([serverId])
}
